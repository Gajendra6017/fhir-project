{
	"name": "PL_FHIR_STAGING",
	"properties": {
		"activities": [
			{
				"name": "Get_Bronze_Files",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "SP_Audit_Start",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_ADLS_JSON",
						"type": "DatasetReference",
						"parameters": {
							"pFileName": "@string('')",
							"pContainer": {
								"value": "@pipeline().parameters.pTargetContainer",
								"type": "Expression"
							},
							"pFolderPath": {
								"value": "@pipeline().parameters.pTargetFolder",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "Filter_Json_Files",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get_Bronze_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get_Bronze_Files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(equals(item().type,'File'),endsWith(item().name,'.json'))\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach_Bronze_File",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Filter_Json_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Filter_Json_Files').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy_Bronze_To_SQL",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_ADLS_JSON",
									"type": "DatasetReference",
									"parameters": {
										"pFileName": "@item().name",
										"pContainer": {
											"value": "@pipeline().parameters.pTargetContainer",
											"type": "Expression"
										},
										"pFolderPath": {
											"value": "@pipeline().parameters.pTargetFolder",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_SQL_STAGING",
									"type": "DatasetReference",
									"parameters": {
										"pSchemaName": "dbo",
										"pTableName": "@dataset().pTableName"
									}
								}
							]
						},
						{
							"name": "SP_Audit_Success",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Copy_Bronze_To_SQL",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[SP_Audit_Success]",
								"storedProcedureParameters": {
									"Run_ID": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"Resource_Name": {
										"value": {
											"value": "@pipeline().parameters.pResourceName",
											"type": "Expression"
										},
										"type": "String"
									},
									"Records_Extracted": {
										"value": {
											"value": "@activity('Copy_Bronze_To_SQL').output.rowsCopied",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AZURE_SQ",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SP_Audit_Failure",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Copy_Bronze_To_SQL",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[SP_Audit_Failure]",
								"storedProcedureParameters": {
									"Run_ID": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"Resource_Name": {
										"value": {
											"value": "@pipeline().parameters.pResourceName",
											"type": "Expression"
										},
										"type": "String"
									},
									"Error_Message": {
										"value": {
											"value": "@activity('Copy_Bronze_To_SQL').output.error.message",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AZURE_SQ",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "SP_Audit_Start",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[SP_Audit_Start]",
					"storedProcedureParameters": {
						"Run_ID": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"Resource_Name": {
							"value": {
								"value": "@pipeline().parameters.pResourceName",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AZURE_SQ",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"pResourceName": {
				"type": "string"
			},
			"pTargetContainer": {
				"type": "string"
			},
			"pTargetFolder": {
				"type": "string"
			}
		},
		"annotations": []
	}
}