{
	"name": "pl_ingest_resource",
	"properties": {
		"activities": [
			{
				"name": "UntilNextLink",
				"type": "Until",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(equals(variables('nextUrl'), ''), equals(variables('nextUrl'), null))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "GetPage",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"headers": {
									"Accept": "application/fhir+json"
								},
								"url": {
									"value": "@variables('nextUrl')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "IncrementPage",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "GetPage",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "pageNum",
								"value": {
									"value": "@add(variables('pageNum'), 1)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "LandRawPage",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "IncrementPage",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_REST_FHIR_API",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_STORAGE",
									"type": "DatasetReference"
								}
							]
						},
						{
							"name": "AdvanceCursor",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "LandRawPage",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "nextUrl",
								"value": {
									"value": "@if(\n    empty(activity('GetPage').output.link),\n    '',\n    coalesce(\n      first(\n        filter(\n          activity('GetPage').output.link,\n          item => equals(item.relation, 'next')\n        )\n      ).url,\n      ''\n    )\n)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "TrackMaxLastUpdated",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "AdvanceCursor",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "maxLastUpdated",
								"value": {
									"value": "@if(\n    greater(\n      ticks(activity('GetPage').output.meta.lastUpdated),\n      ticks(variables('maxLastUpdated'))\n    ),\n    activity('GetPage').output.meta.lastUpdated,\n    variables('maxLastUpdated')\n)",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "01:00:00"
				}
			}
		],
		"parameters": {
			"resourceType": {
				"type": "string",
				"defaultValue": "'Patient"
			},
			"baseUrl": {
				"type": "string",
				"defaultValue": "https://hapi.fhir.org/baseR4"
			},
			"sinceDate": {
				"type": "string",
				"defaultValue": "1970-01-01T00:00:00Z"
			},
			"runId": {
				"type": "string",
				"defaultValue": "@pipeline().RunId"
			},
			"ingestDate": {
				"type": "string",
				"defaultValue": "@utcnow('yyyy-MM-dd')"
			},
			"pageSize": {
				"type": "int",
				"defaultValue": 100
			}
		},
		"variables": {
			"nextUrl": {
				"type": "String",
				"defaultValue": "https://hapi.fhir.org/baseR4/Patient?_count=100"
			},
			"pageNum": {
				"type": "Integer",
				"defaultValue": 0
			},
			"maxLastUpdated": {
				"type": "String",
				"defaultValue": "'1970-01-01T00:00:00Z'"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-11-12T15:11:09Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}