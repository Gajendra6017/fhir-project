{
	"name": "PL_FHIR_TRANSFORM",
	"properties": {
		"activities": [
			{
				"name": "Lookup_Staging_Count",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "SP_Audit_Start",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT COUNT(*) AS Total_Records\nFROM dbo.FHIR_Raw_Staging\nWHERE Resource_Name = '@{pipeline().parameters.pResourceName}'\nAND Run_ID = '@{pipeline().parameters.pRunID}';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_STAGING",
						"type": "DatasetReference",
						"parameters": {
							"pSchemaName": "dbo",
							"pTableName": "@pipeline().parameters.pTableName"
						}
					}
				}
			},
			{
				"name": "IF_Data_Available",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Lookup_Staging_Count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(\n    activity('Lookup_Staging_Count').output.firstRow.Total_Records,\n    0\n)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Execute_switch",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_FHIR_TRANSFORM_ROUTER",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						}
					]
				}
			},
			{
				"name": "SP_Audit_Start",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[SP_Audit_Start]"
				},
				"linkedServiceName": {
					"referenceName": "LS_AZURE_SQ",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_Audit_Success",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "IF_Data_Available",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[SP_Audit_Success]"
				},
				"linkedServiceName": {
					"referenceName": "LS_AZURE_SQ",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_Audit_Failure",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "IF_Data_Available",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[SP_Audit_Failure]"
				},
				"linkedServiceName": {
					"referenceName": "LS_AZURE_SQ",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"pResourceName": {
				"type": "string"
			},
			"pRunID": {
				"type": "string"
			}
		},
		"annotations": []
	}
}