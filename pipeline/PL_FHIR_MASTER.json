{
	"name": "PL_FHIR_MASTER",
	"properties": {
		"activities": [
			{
				"name": "Lookup_API_Metadata",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "SP_Audit_Start",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT * FROM dbo.API_Metadata\nWHERE Is_Active = 1\nORDER BY Execution_Order;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_API_METADATA",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Resource",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_API_Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_API_Metadata').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Execute_Resource_Pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_FHIR_INGEST_RESOURCE",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"pAPI_ID": {
										"value": "@item().API_ID",
										"type": "Expression"
									},
									"pResourceName": {
										"value": "@item().Resource_Name",
										"type": "Expression"
									},
									"pBaseURL": {
										"value": "@item().Base_URL",
										"type": "Expression"
									},
									"pRelativeURL": {
										"value": "@item().Relative_URL",
										"type": "Expression"
									},
									"pHTTPMethod": {
										"value": "@item().HTTP_Method",
										"type": "Expression"
									},
									"pPageSize": {
										"value": "@item().Page_Size",
										"type": "Expression"
									},
									"pPaginationType": {
										"value": "@item().Pagination_Type",
										"type": "Expression"
									},
									"pPaginationRule": {
										"value": "@item().Pagination_Rule",
										"type": "Expression"
									},
									"pLoadType": {
										"value": "@item().Load_Type",
										"type": "Expression"
									},
									"pTargetContainer": {
										"value": "@item().Target_Container",
										"type": "Expression"
									},
									"pTargetFolder": {
										"value": "@item().Target_Folder",
										"type": "Expression"
									},
									"pExecutionOrder": {
										"value": "@item().Execution_Order",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "PL_FHIR_STAGING",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Execute_Resource_Pipeline",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_FHIR_STAGING",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"pResourceName": {
										"value": "@pipeline().parameters.pResourceName",
										"type": "Expression"
									},
									"pTargetContainer": {
										"value": "@pipeline().parameters.pTargetContainer",
										"type": "Expression"
									},
									"pTargetFolder": {
										"value": "@pipeline().parameters.pTargetFolder",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Execute_PL_FHIR_TRANSFORM",
							"type": "ExecutePipeline",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [
								{
									"activity": "PL_FHIR_STAGING",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_FHIR_TRANSFORM",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"pResourceName": {
										"value": "@pipeline().parameters.pResourceName",
										"type": "Expression"
									},
									"pRunID": {
										"value": "@variables('vRunID')",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "SP_Update_Watermark",
							"type": "SqlServerStoredProcedure",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [
								{
									"activity": "Execute_PL_FHIR_TRANSFORM",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[SP_Update_Watermark]"
							},
							"linkedServiceName": {
								"referenceName": "LS_AZURE_SQ",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SP_Audit_Success",
							"type": "SqlServerStoredProcedure",
							"state": "Inactive",
							"onInactiveMarkAs": "Succeeded",
							"dependsOn": [
								{
									"activity": "SP_Update_Watermark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[SP_Audit_Success]"
							},
							"linkedServiceName": {
								"referenceName": "LS_AZURE_SQ",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "SP_Audit_Start",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[SP_Audit_Start]",
					"storedProcedureParameters": {
						"Run_ID": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"Resource_Name": {
							"value": "Patient",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AZURE_SQ",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"pResourceName": {
				"type": "string"
			},
			"pTargetFolder": {
				"type": "string"
			},
			"pTargetContainer": {
				"type": "string"
			}
		},
		"annotations": []
	}
}