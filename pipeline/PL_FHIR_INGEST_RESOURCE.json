						"activity": "Set_Cutoff_Time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(\n    equals(pipeline().parameters.pLoadType,'FULL'),\n    empty(activity('Lookup_Watermark').output.firstRow.Last_Watermark)\n)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Set_Initial_URL_INCREMENTAL",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "vInitialRelativeURL",
								"value": {
									"value": "@concat(\n    pipeline().parameters.pRelativeURL,\n    '?_lastUpdated=ge',\n    formatDateTime(\n        addMinutes(\n            activity('Lookup_Watermark').output.firstRow.Last_Watermark,\n            -5\n        ),\n        'yyyy-MM-ddTHH:mm:ssZ'\n    ),\n    '&_count=',\n    string(pipeline().parameters.pPageSize)\n)",
									"type": "Expression"
								}
							}
