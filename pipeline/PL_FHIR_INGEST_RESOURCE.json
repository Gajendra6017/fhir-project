										"AbsoluteUrl": "$.link[?(@.relation=='next')].url",
										"MaxRequestNumber": "100"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
